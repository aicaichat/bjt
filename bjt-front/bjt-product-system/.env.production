# 生产环境配置文件示例
# 复制此文件为 .env.production 并修改相应的值

# 数据库配置
MYSQL_ROOT_PASSWORD=bjtpassword123
MYSQL_DATABASE=bjt
MYSQL_USER=wordpress
MYSQL_PASSWORD=bjtpassword123

# WordPress配置
WORDPRESS_DB_HOST=mysql
WORDPRESS_DB_NAME=bjt
WORDPRESS_DB_USER=wordpress
WORDPRESS_DB_PASSWORD=bjtpassword123
WORDPRESS_DB_CHARSET=utf8mb4
WORDPRESS_DB_COLLATE=

# WordPress安全密钥 (请替换为随机生成的密钥)
# 可以在 https://api.wordpress.org/secret-key/1.1/salt/ 生成
WORDPRESS_AUTH_KEY=simple_key_value
WORDPRESS_SECURE_AUTH_KEY=simple_key_value
WORDPRESS_LOGGED_IN_KEY=simple_key_value
WORDPRESS_NONCE_KEY=simple_key_value
WORDPRESS_AUTH_SALT=simple_key_value
WORDPRESS_SECURE_AUTH_SALT=simple_key_value
WORDPRESS_LOGGED_IN_SALT=simple_key_value
WORDPRESS_NONCE_SALT=simple_key_value

# JWT配置
JWT_AUTH_SECRET_KEY=simple_key_value

# 域名配置 (请替换为你的实际域名)
DOMAIN_NAME=bjt.nh.cool
WP_HOME=https://bjt.nh.cool
WP_SITEURL=https://bjt.nh.cool

# SSL证书路径
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/private.key

# 备份配置
BACKUP_SCHEDULE="0 2 * * *"
BACKUP_RETENTION_DAYS=30 