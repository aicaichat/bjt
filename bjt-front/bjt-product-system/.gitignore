# BJT Product System .gitignore

# Node.js
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Build outputs
frontend/dist/
frontend/build/

# Environment files
.env
.env.local
.env.development
.env.production
.env.production.ip

# Uploads directory (user generated content)
frontend/public/uploads/
uploads/
wp-content/uploads/

# Logs
logs/
*.log
debug.log
error.log

# Database dumps
*.sql
backups/

# IDE files
.vscode/
.idea/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db

# Docker
.docker/

# Python virtual environment
venv/
__pycache__/
*.pyc

# WordPress specific
wp-config.php
.htaccess

# Playwright / E2E 生成物（勿提交）
frontend/playwright-report/
frontend/test-results/
frontend/e2e-results.json
frontend/e2e-results.xml

# Temporary files
*.tmp
*.temp
test-*.txt
test-*.pdf

# SSL certificates (should be managed separately)
nginx/ssl/*.pem
nginx/ssl/*.key
nginx/ssl/*.crt 
# BJT uploads ignore rules - 忽略用户上传文件但保留目录结构
frontend/public/uploads/*
!frontend/public/uploads/.gitkeep
!frontend/public/uploads/README.md
uploads_backup_*
