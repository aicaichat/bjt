# Database Configuration
DB_HOST=localhost
DB_USER=wordpress
DB_PASSWORD=wordpress
DB_NAME=bjt_product
DB_PORT=3306

# Path to the directory in the frontend project where generated mock .ts files will be written
# Example: ../../bjt-front/bjt-product-system/frontend/src/services/mocks
# Ensure this path is correct relative to where you run the bjt-data-sync scripts.
FRONTEND_MOCK_DIR=../frontend/src/services/mocks

# Relative path from the FRONTEND_MOCK_DIR to the directory containing frontend type definitions
# Example: if mocks are in services/mocks/ and types are in types/, this would be ../../types
FRONTEND_TYPES_DIR_RELATIVE_TO_MOCKS=../../types

# Base URL for assets, if needed by the script to resolve image paths for mocks
# This should match what ASSETS.getUrl() in your frontend would use as a base, or be the full base URL for images.
# Example: http://localhost:5173/assets or just /assets if frontend handles the host.
# For now, let's assume relative paths from a common /assets root, matching ASSETS.getUrl in appConfig.
# If your ASSETS.getUrl already constructs full URLs or uses a dynamic base, this might need adjustment or not be used directly if mock files store relative paths.
ASSETS_BASE_PATH=/assets 