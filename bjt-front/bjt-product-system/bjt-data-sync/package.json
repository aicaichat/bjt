{
  "name": "bjt-data-sync",
  "version": "1.0.0",
  "description": "Scripts to synchronize data between BJT database and frontend mock files.",
  "main": "dist/db-to-mock.js",
  "scripts": {
    "build": "tsc",
    "start:db-to-mock": "ts-node src/db-to-mock.ts",
    "start:mock-to-db": "ts-node src/mock-to-db.ts",
    "dev:db-to-mock": "nodemon --watch src --ext ts --exec ts-node src/db-to-mock.ts",
    "dev:mock-to-db": "nodemon --watch src --ext ts --exec ts-node src/mock-to-db.ts",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [
    "bjt",
    "data-sync",
    "mock",
    "database"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^4.18.2",
    "fs-extra": "^11.2.0",
    "mysql2": "^3.6.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/fs-extra": "^11.0.4",
    "@types/node": "^20.10.4",
    "nodemon": "^3.0.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
