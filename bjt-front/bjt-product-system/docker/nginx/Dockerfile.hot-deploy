# 热部署版本：不构建前端，仅配置nginx
FROM nginx:alpine

# 安装必要的工具
RUN apk add --no-cache curl bash

# 复制nginx配置文件
COPY nginx/conf.d/production.conf /etc/nginx/conf.d/default.conf

# 创建nginx用户和组（如果不存在）
RUN addgroup -g 101 -S nginx || true && \
    adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx || true

# 创建前端目录和nginx运行时目录
RUN mkdir -p /usr/share/nginx/html && \
    mkdir -p /var/cache/nginx/client_temp && \
    mkdir -p /var/cache/nginx/proxy_temp && \
    mkdir -p /var/cache/nginx/fastcgi_temp && \
    mkdir -p /var/cache/nginx/uwsgi_temp && \
    mkdir -p /var/cache/nginx/scgi_temp && \
    chown -R nginx:nginx /usr/share/nginx/html && \
    chown -R nginx:nginx /var/cache/nginx && \
    chown -R nginx:nginx /var/log/nginx

# 创建前端热部署支持脚本
RUN echo '#!/bin/bash' > /usr/local/bin/hot-deploy-support.sh && \
    echo '' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '# 前端热部署支持脚本' >> /usr/local/bin/hot-deploy-support.sh && \
    echo 'FRONTEND_DIR="/usr/share/nginx/html"' >> /usr/local/bin/hot-deploy-support.sh && \
    echo 'NGINX_PID_FILE="/var/run/nginx.pid"' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '# 检查前端目录是否存在' >> /usr/local/bin/hot-deploy-support.sh && \
    echo 'check_frontend_dir() {' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '    if [ ! -d "$FRONTEND_DIR" ]; then' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '        echo "创建前端目录: $FRONTEND_DIR"' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '        mkdir -p "$FRONTEND_DIR"' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '        chown nginx:nginx "$FRONTEND_DIR"' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '    fi' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '}' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '# 优雅重载nginx' >> /usr/local/bin/hot-deploy-support.sh && \
    echo 'reload_nginx() {' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '    if [ -f "$NGINX_PID_FILE" ]; then' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '        echo "重新加载nginx配置..."' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '        nginx -s reload' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '    else' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '        echo "nginx未运行"' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '    fi' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '}' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '# 主函数' >> /usr/local/bin/hot-deploy-support.sh && \
    echo 'main() {' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '    echo "启动前端热部署支持..."' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '    check_frontend_dir' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '    if [ "$1" != "init" ]; then' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '        reload_nginx' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '    fi' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '}' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '' >> /usr/local/bin/hot-deploy-support.sh && \
    echo '# 执行主函数' >> /usr/local/bin/hot-deploy-support.sh && \
    echo 'main "$@"' >> /usr/local/bin/hot-deploy-support.sh && \
    chmod +x /usr/local/bin/hot-deploy-support.sh

# 创建默认前端页面
RUN echo '<!DOCTYPE html>' > /usr/share/nginx/html/index.html && \
    echo '<html lang="zh-CN">' >> /usr/share/nginx/html/index.html && \
    echo '<head>' >> /usr/share/nginx/html/index.html && \
    echo '    <meta charset="UTF-8">' >> /usr/share/nginx/html/index.html && \
    echo '    <meta name="viewport" content="width=device-width, initial-scale=1.0">' >> /usr/share/nginx/html/index.html && \
    echo '    <title>BJT产品管理系统</title>' >> /usr/share/nginx/html/index.html && \
    echo '    <style>' >> /usr/share/nginx/html/index.html && \
    echo '        body { font-family: Arial, sans-serif; text-align: center; padding: 50px; }' >> /usr/share/nginx/html/index.html && \
    echo '        .container { max-width: 600px; margin: 0 auto; }' >> /usr/share/nginx/html/index.html && \
    echo '        .status { color: #ff6b35; font-size: 18px; margin: 20px 0; }' >> /usr/share/nginx/html/index.html && \
    echo '        .info { color: #666; font-size: 14px; }' >> /usr/share/nginx/html/index.html && \
    echo '    </style>' >> /usr/share/nginx/html/index.html && \
    echo '</head>' >> /usr/share/nginx/html/index.html && \
    echo '<body>' >> /usr/share/nginx/html/index.html && \
    echo '    <div class="container">' >> /usr/share/nginx/html/index.html && \
    echo '        <h1>BJT产品管理系统</h1>' >> /usr/share/nginx/html/index.html && \
    echo '        <div class="status">前端应用准备中...</div>' >> /usr/share/nginx/html/index.html && \
    echo '        <div class="info">' >> /usr/share/nginx/html/index.html && \
    echo '            <p>系统正在等待前端应用部署。</p>' >> /usr/share/nginx/html/index.html && \
    echo '            <p>请使用热部署脚本更新前端应用。</p>' >> /usr/share/nginx/html/index.html && \
    echo '        </div>' >> /usr/share/nginx/html/index.html && \
    echo '    </div>' >> /usr/share/nginx/html/index.html && \
    echo '</body>' >> /usr/share/nginx/html/index.html && \
    echo '</html>' >> /usr/share/nginx/html/index.html && \
    chown nginx:nginx /usr/share/nginx/html/index.html

# 创建nginx启动脚本
RUN echo '#!/bin/sh' > /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo '' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo '# 初始化热部署支持' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo 'echo "初始化前端热部署支持..."' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo '/usr/local/bin/hot-deploy-support.sh init' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo '' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo '# 设置正确的权限' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo 'chown -R nginx:nginx /usr/share/nginx/html' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo 'chmod -R 755 /usr/share/nginx/html' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo '' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    echo 'echo "前端热部署支持已初始化"' >> /docker-entrypoint.d/30-hot-deploy-init.sh && \
    chmod +x /docker-entrypoint.d/30-hot-deploy-init.sh

# 暴露端口
EXPOSE 80 443

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# 启动nginx
CMD ["nginx", "-g", "daemon off;"] 