# 多阶段构建：先构建前端，再构建nginx
FROM node:18-alpine as frontend-builder

# 设置工作目录
WORKDIR /app

# 复制前端 package 文件（同时支持有/无 lock 文件）
COPY frontend/package*.json ./

# 安装依赖：如果有 lock 文件用 npm ci，否则用 npm install
RUN sh -c '[ -f package-lock.json ] && npm ci --prefer-online || npm install --legacy-peer-deps'

# 复制前端源代码
COPY frontend/ ./

# 设置环境变量
ARG VITE_API_URL
ENV VITE_API_URL=${VITE_API_URL}

# 构建前端应用（跳过TypeScript检查）
RUN npm run build:skip-check

# 第二阶段：构建nginx镜像
FROM nginx:alpine

# 安装必要的工具
RUN apk add --no-cache curl

# 复制前端构建结果（修复：使用正确的dist目录）
COPY --from=frontend-builder /app/dist /usr/share/nginx/html

# 复制nginx配置文件
COPY nginx/conf.d/production.conf /etc/nginx/conf.d/default.conf

# 创建nginx用户和组（如果不存在）
RUN addgroup -g 101 -S nginx || true
RUN adduser -S -D -H -u 101 -h /var/cache/nginx -s /sbin/nologin -G nginx -g nginx nginx || true

# 设置正确的权限
RUN chown -R nginx:nginx /usr/share/nginx/html
RUN chown -R nginx:nginx /var/cache/nginx
RUN chown -R nginx:nginx /var/log/nginx

# 创建nginx运行时需要的目录
RUN mkdir -p /var/cache/nginx/client_temp
RUN mkdir -p /var/cache/nginx/proxy_temp
RUN mkdir -p /var/cache/nginx/fastcgi_temp
RUN mkdir -p /var/cache/nginx/uwsgi_temp
RUN mkdir -p /var/cache/nginx/scgi_temp

# 设置权限
RUN chown -R nginx:nginx /var/cache/nginx

# 暴露端口
EXPOSE 80 443

# 健康检查
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost/ || exit 1

# 启动nginx
CMD ["nginx", "-g", "daemon off;"] 