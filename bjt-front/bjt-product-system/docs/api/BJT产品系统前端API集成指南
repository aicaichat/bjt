### 文件上传API调用示例

```typescript
// api/uploads.ts
import http from './httpService';
import { CancelToken } from 'axios';

export function uploadFile(
  file: File, 
  onUploadProgress?: (progressEvent: ProgressEvent) => void,
  cancelToken?: CancelToken
) {
  const formData = new FormData();
  formData.append('file', file);
  
  return http.request({
    method: 'POST',
    url: '/uploads',
    data: formData,
    headers: {
      'Content-Type': 'multipart/form-data'
    },
    onUploadProgress,
    cancelToken
  });
}

// 使用示例
import { useState } from 'react';
import { uploadFile } from '../api/uploads';
import { useCancelToken } from '../hooks/useCancelToken';

const FileUploader = () => {
  const [progress, setProgress] = useState(0);
  const { getCancelToken } = useCancelToken();
  
  const handleUpload = async (file: File) => {
    try {
      await uploadFile(
        file,
        (progressEvent) => {
          const percent = Math.round((progressEvent.loaded * 100) / progressEvent.total);
          setProgress(percent);
        },
        getCancelToken()
      );
      alert('上传成功');
    } catch (error) {
      if (axios.isCancel(error)) {
        console.log('上传已取消');
      } else {
        alert('上传失败');
      }
    }
  };
  
  return (
    <div>
      <input type="file" onChange={(e) => e.target.files?.[0] && handleUpload(e.target.files[0])} />
      {progress > 0 && <progress value={progress} max="100" />}
    </div>
  );
};
```

### 带分页/筛选的列表请求示例

```tsx
// components/ProductList.tsx
import React, { useState, useEffect } from 'react';
import { useQueryParams, StringParam, NumberParam } from 'use-query-params';
import { getProductLines } from '../api/products';
import { ProductLineModel } from '../api/types/models/product';
import Pagination from './Pagination';
import LoadingSpinner from './LoadingSpinner';
import { useDebounce } from '../hooks/useDebounce';

const ProductList: React.FC = () => {
  const [query, setQuery] = useQueryParams({
    page: NumberParam,
    per_page: NumberParam,
    search: StringParam,
    status: StringParam,
    order: StringParam,
    orderby: StringParam
  });
  
  const [products, setProducts] = useState<ProductLineModel[]>([]);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<Error | null>(null);
  const [total, setTotal] = useState(0);
  const [totalPages, setTotalPages] = useState(0);
  
  const { page = 1, per_page = 10, search = '', status, order = 'desc', orderby = 'id' } = query;
  const debouncedSearch = useDebounce(search, 500);
  
  useEffect(() => {
    const fetchProducts = async () => {
      setLoading(true);
      setError(null);
      try {
        const response = await getProductLines({
          page,
          per_page,
          search: debouncedSearch,
          status,
          order,
          orderby
        });
        
        setProducts(response.data);
        // 从响应头获取分页信息
        const totalItems = parseInt(response.headers['x-wp-total'] || '0', 10);
        const totalPagesFromHeader = parseInt(response.headers['x-wp-totalpages'] || '0', 10);
        
        setTotal(totalItems);
        setTotalPages(totalPagesFromHeader);
      } catch (err) {
        setError(err as Error);
      } finally {
        setLoading(false);
      }
    };
    
    fetchProducts();
  }, [page, per_page, debouncedSearch, status, order, orderby]);
  
  const handlePageChange = (newPage: number) => {
    setQuery({ ...query, page: newPage });
  };
  
  const handleSearchChange = (e: React.ChangeEvent<HTMLInputElement>) => {
    setQuery({ ...query, search: e.target.value, page: 1 });
  };
  
  const handleStatusChange = (e: React.ChangeEvent<HTMLSelectElement>) => {
    setQuery({ 
      ...query, 
      status: e.target.value === 'all' ? undefined : e.target.value, 
      page: 1 
    });
  };
  
  const handleSortChange = (field: string) => {
    const newOrder = orderby === field && order === 'asc' ? 'desc' : 'asc';
    setQuery({ ...query, orderby: field, order: newOrder });
  };
  
  if (loading && page === 1) return <LoadingSpinner fullPage />;
  if (error) return <div>Error: {error.message}</div>;
  
  return (
    <div className="container mx-auto py-6">
      <div className="flex justify-between mb-4">
        <input
          type="text"
          placeholder="搜索产品线..."
          value={search}
          onChange={handleSearchChange}
          className="px-4 py-2 border rounded"
        />
        <select
          value={status || 'all'}
          onChange={handleStatusChange}
          className="px-4 py-2 border rounded"
        >
          <option value="all">全部状态</option>
          <option value="publish">已发布</option>
          <option value="draft">草稿</option>
          <option value="trash">已删除</option>
        </select>
      </div>
      
      {loading && page > 1 && <LoadingSpinner />}
      
      <table className="min-w-full bg-white">
        <thead>
          <tr>
            <th className="py-2 px-4 border-b" onClick={() => handleSortChange('id')}>
              ID {orderby === 'id' && (order === 'asc' ? '↑' : '↓')}
            </th>
            <th className="py-2 px-4 border-b" onClick={() => handleSortChange('title_zh')}>
              名称 {orderby === 'title_zh' && (order === 'asc' ? '↑' : '↓')}
            </th>
            <th className="py-2 px-4 border-b">代码</th>
            <th className="py-2 px-4 border-b">状态</th>
            <th className="py-2 px-4 border-b">操作</th>
          </tr>
        </thead>
        <tbody>
          {products.map(product => (
            <tr key={product.id}>
              <td className="py-2 px-4 border-b">{product.id}</td>
              <td className="py-2 px-4 border-b">{product.title_zh}</td>
              <td className="py-2 px-4 border-b">{product.code}</td>
              <td className="py-2 px-4 border-b">{product.status}</td>
              <td className="py-2 px-4 border-b">
                <button className="mr-2 text-blue-500">编辑</button>
                <button className="text-red-500">删除</button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
      
      <Pagination
        currentPage={page}
        totalPages={totalPages}
        onPageChange={handlePageChange}
        className="mt-4"
      />
    </div>
  );
};

export default ProductList;
```

