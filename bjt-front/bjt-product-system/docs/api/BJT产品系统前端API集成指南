// api/products.ts
import http from './httpService';
import { BJTResponse, PaginatedResponse, PaginationParams, SortParams } from './types/responses';
import { ProductLineModel } from './types/models/product';
import { CreateProductLineRequest } from './types/requests';

// 获取产品线列表
export function getProductLines(params?: PaginationParams & SortParams & { search?: string, status?: string }) {
  return http.request<ProductLineModel[]>({
    method: 'GET',
    url: '/product-lines',
    params
  });
}

// 获取单个产品线
export function getProductLine(id: number) {
  return http.request<ProductLineModel>({
    method: 'GET',
    url: `/product-lines/${id}`
  });
}

// 创建产品线
export function createProductLine(data: CreateProductLineRequest) {
  return http.request<ProductLineModel>({
    method: 'POST',
    url: '/product-lines',
    data
  });
}

// 更新产品线
export function updateProductLine(id: number, data: Partial<CreateProductLineRequest>) {
  return http.request<ProductLineModel>({
    method: 'PUT',
    url: `/product-lines/${id}`,
    data
  });
}

// 删除产品线
export function deleteProductLine(id: number) {
  return http.request<{ id: number }>({
    method: 'DELETE',
    url: `/product-lines/${id}`
  });
}
