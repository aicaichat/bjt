### 🛠️ **标准修复模板**

#### **后端权限修复模板（Controller）**
```php
public function check_write_permission($request) {
    if (!BJT_Auth_Controller::is_user_logged_in()) {
        return new WP_Error('not_logged_in', 'User not logged in', array('status' => 401));
    }
    
    $user = $GLOBALS['bjt_current_user'] ?? null;
    if (!$user || !in_array($user['role'], ['admin', 'manager'])) {
        return new WP_Error('insufficient_permission', 'Insufficient permission', array('status' => 403));
    }
    
    if (!BJT_Auth_Controller::user_has_permission($user, 'edit_products')) {
        return new WP_Error('no_edit_permission', 'No edit permission', array('status' => 403));
    }
    
    return true;
}
```

#### **前端数据处理修复模板（页面组件）**
```typescript
const onFinish = async (values: any) => {
    try {
        // 1. 数据清理 - 过滤空值
        const cleanedValues = Object.fromEntries(
            Object.entries(values).filter(([_, value]) => 
                value !== '' && value !== null && value !== undefined
            )
        );

        // 2. 字段映射和类型转换 - 根据API文档准确映射
        const finalData = {
            api_field: cleanedValues.form_field ? String(cleanedValues.form_field) : undefined,
            numeric_field: cleanedValues.number_field ? Number(cleanedValues.number_field) : undefined,
            // 特殊处理：ID转字符串、嵌套对象展开等
        };

        // 3. 过滤undefined值
        const submitData = Object.fromEntries(
            Object.entries(finalData).filter(([_, value]) => value !== undefined)
        );

        // 4. 调试日志 - 方便排查
        console.log('Form submit - Final data:', submitData);

        // 5. API调用
        if (isEditMode) {
            await service.updateItem(id, submitData);
        } else {
            await service.createItem(submitData);
        }

        message.success('操作成功');
        navigate('/admin/list');
    } catch (error) {
        // 6. 详细错误处理
        console.error('Submit failed:', error);
        let errorMessage = '操作失败';
        if (error?.response?.data?.message) {
            errorMessage = error.response.data.message;
        } else if (error?.message) {
            errorMessage = error.message;
        }
        message.error(errorMessage);
    }
};
```

