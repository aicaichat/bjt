// 在 service 文件中添加数据清理
const cleanApiData = (data: any) => {
  const cleaned = { ...data };
  
  // 移除空值和undefined
  Object.keys(cleaned).forEach(key => {
    if (cleaned[key] === null || cleaned[key] === undefined || cleaned[key] === '') {
      delete cleaned[key];
    }
  });
  
  // 转换数字字段
  if (cleaned.product_line_id) cleaned.product_line_id = Number(cleaned.product_line_id);
  if (cleaned.sort_order) cleaned.sort_order = Number(cleaned.sort_order);
  
  // 转换字符串字段
  ['code', 'name_cn', 'name_en'].forEach(field => {
    if (cleaned[field] && typeof cleaned[field] !== 'string') {
      cleaned[field] = String(cleaned[field]);
    }
  });
  
  return cleaned;
};

// 在页面组件中添加错误处理
const handleSubmit = async (formData: any) => {
  try {
    const cleanedData = cleanApiData(formData);
    const result = await service.create(cleanedData);
    
    if (result.success) {
      message.success('创建成功');
      router.push('/admin/list');
    } else {
      message.error(result.message || '创建失败');
    }
  } catch (error: any) {
    console.error('Submit error:', error);
    if (error.response?.data?.message) {
      message.error(error.response.data.message);
    } else {
      message.error('网络错误，请稍后重试');
    }
  }
};
```

