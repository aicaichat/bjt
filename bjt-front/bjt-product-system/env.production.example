# BJT Product System - 生产环境配置
# 复制此文件为 .env.production 并填写实际值

# 域名配置
DOMAIN_NAME=your-domain.com

# SSL证书路径（在容器内的路径）
SSL_CERT_PATH=/etc/nginx/ssl/cert.pem
SSL_KEY_PATH=/etc/nginx/ssl/key.pem

# 数据库配置
MYSQL_ROOT_PASSWORD=your_strong_root_password
MYSQL_DATABASE=bjt_product_prod
MYSQL_USER=bjt_user
MYSQL_PASSWORD=your_strong_password

# WordPress配置
WORDPRESS_DB_CHARSET=utf8mb4
WORDPRESS_DB_COLLATE=utf8mb4_unicode_ci

# WordPress安全密钥（使用 https://api.wordpress.org/secret-key/1.1/salt/ 生成）
WORDPRESS_AUTH_KEY='put your unique phrase here'
WORDPRESS_SECURE_AUTH_KEY='put your unique phrase here'
WORDPRESS_LOGGED_IN_KEY='put your unique phrase here'
WORDPRESS_NONCE_KEY='put your unique phrase here'
WORDPRESS_AUTH_SALT='put your unique phrase here'
WORDPRESS_SECURE_AUTH_SALT='put your unique phrase here'
WORDPRESS_LOGGED_IN_SALT='put your unique phrase here'
WORDPRESS_NONCE_SALT='put your unique phrase here'

# JWT认证密钥
JWT_AUTH_SECRET_KEY='your-jwt-secret-key-here'

# WordPress URL配置
WP_HOME=https://your-domain.com
WP_SITEURL=https://your-domain.com

# 备份配置
BACKUP_SCHEDULE="0 2 * * *"  # 每天凌晨2点备份

# 前端API配置
VITE_API_URL=https://your-domain.com/wp-json/bjt/v1
VITE_USE_MOCK_DATA=false
VITE_USE_PROXY=false

# 其他配置
NODE_ENV=production
TZ=Asia/Shanghai 