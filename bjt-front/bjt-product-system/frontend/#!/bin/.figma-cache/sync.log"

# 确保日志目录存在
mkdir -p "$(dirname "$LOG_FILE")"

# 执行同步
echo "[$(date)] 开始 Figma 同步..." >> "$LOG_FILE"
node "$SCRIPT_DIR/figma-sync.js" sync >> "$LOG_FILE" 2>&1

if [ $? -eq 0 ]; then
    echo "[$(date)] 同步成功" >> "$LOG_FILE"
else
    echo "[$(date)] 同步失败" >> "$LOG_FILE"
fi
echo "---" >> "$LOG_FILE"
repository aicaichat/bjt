#!/bin/bash
# Figma 数据同步定时任务脚本
# 添加到 crontab: crontab -e
# 或使用 launchd (macOS)

# 设置 Token
export FIGMA_TOKEN="${FIGMA_TOKEN:-figd_hCCBa9ZcfsoYCAy8Uj7Ro4QiPppogCAec-tGkoEc}"

# 脚本目录
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
LOG_FILE="$SCRIPT_DIR/../.figma-cache/sync.log"

# 确保日志目录存在
mkdir -p "$(dirname "$LOG_FILE")"

# 执行同步
echo "[$(date)] 开始 Figma 同步..." >> "$LOG_FILE"
node "$SCRIPT_DIR/figma-sync.js" sync >> "$LOG_FILE" 2>&1

if [ $? -eq 0 ]; then
    echo "[$(date)] 同步成功" >> "$LOG_FILE"
else
    echo "[$(date)] 同步失败" >> "$LOG_FILE"
fi
echo "---" >> "$LOG_FILE"
