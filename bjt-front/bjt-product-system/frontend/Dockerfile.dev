FROM node:18-alpine

WORKDIR /app

# 安装必要的构建工具
RUN apk add --no-cache python3 make g++ curl

# 复制package文件
COPY package*.json ./

# 清理 npm 缓存并重新安装依赖
RUN npm cache clean --force && \
    rm -rf node_modules && \
    npm install

# 复制所有文件
COPY . .

# 修复Tailwind CSS和PostCSS配置
RUN echo "修复PostCSS配置..." && \
    cat > postcss.config.js << 'EOF' && \
export default { && \
  plugins: { && \
    'postcss-import': {}, && \
    'tailwindcss/nesting': 'postcss-nested', && \
    'tailwindcss': {}, && \
    'autoprefixer': {}, && \
    'postcss-preset-env': { && \
      features: { && \
        'nesting-rules': false && \
      } && \
    } && \
  } && \
} && \
EOF

# 确保Tailwind CSS依赖已安装
RUN npm install --save-dev @tailwindcss/postcss tailwindcss@latest postcss@latest autoprefixer@latest postcss-import@latest postcss-nested@latest postcss-preset-env@latest

# 验证配置
RUN node -e "import('./postcss.config.js').then(() => console.log('PostCSS config OK')).catch(e => console.error('PostCSS config error:', e.message))" && \
    node -e "import('./tailwind.config.js').then(() => console.log('Tailwind config OK')).catch(e => console.error('Tailwind config error:', e.message))"

EXPOSE 5173

ENV VITE_HOST=0.0.0.0

# 使用开发模式启动
CMD ["sh", "-c", "npm run dev -- --host ${VITE_HOST}"] 