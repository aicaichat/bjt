# 前端生产环境构建
FROM node:18-alpine as builder

# 设置工作目录
WORKDIR /app

# 复制package文件
COPY package*.json ./

# 安装所有依赖（包括devDependencies，构建时需要）
RUN npm ci

# 复制源代码
COPY . .

# 构建应用（输出到build目录）
RUN npm run build

# 使用nginx作为生产服务器
FROM nginx:alpine

# 复制构建结果到nginx（从build目录而不是dist目录）
COPY --from=builder /app/build /usr/share/nginx/html

# 复制nginx配置
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 暴露端口
EXPOSE 80

# 启动nginx
CMD ["nginx", "-g", "daemon off;"]
