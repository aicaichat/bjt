# 环境变量配置示例
# 复制此文件为 .env.local 或 .env.development 并根据需要修改

# WordPress主机地址 - 根据环境调整
# 开发环境 (Docker)
VITE_WORDPRESS_HOST=http://dev-wordpress-1:80

# 生产环境 (Docker)  
# VITE_WORDPRESS_HOST=http://wordpress:80

# 生产环境 (通过Nginx代理)
# VITE_WORDPRESS_HOST=

# API基础路径
VITE_API_URL=/wp-json/bjt/v1

# 是否使用代理
VITE_USE_PROXY=true

# 调试模式
VITE_DEBUG=true 