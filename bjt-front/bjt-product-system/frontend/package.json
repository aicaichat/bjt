{
  "name": "bjt-product-system-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "build-skip-ts": "vite build",
    "build-mock": "tsc -b && vite build --mode production.mock",
    "build-mock-skip-ts": "vite build --mode production.mock",
    "test": "npm run test:real-ts",
    "test:real-ts": "node real-ts-test-runner.cjs",
    "test:real-api": "tsx src/tests/real-api/run-tests.ts",
    "test:real-api:help": "node real-api-test-runner.cjs --help",
    "test:real-api:local": "VITE_API_ENVIRONMENT=local node real-api-test-runner.cjs",
    "test:real-api:docker": "VITE_API_ENVIRONMENT=docker VITE_API_URL=http://127.0.0.1:80/wp-json node real-api-test-runner.cjs",
    "test:all": "npm run test:real-ts && npm run test:real-api"
  },
  "dependencies": {
    "@ant-design/icons": "^6.0.0",
    "antd": "^5.24.7",
    "axios": "^1.8.4",
    "connect-history-api-fallback": "^2.0.0",
    "date-fns": "^4.1.0",
    "dotenv": "^16.5.0",
    "file-saver": "^2.0.5",
    "i18next": "^25.0.1",
    "i18next-browser-languagedetector": "^8.0.5",
    "lucide-react": "^0.511.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hook-form": "^7.55.0",
    "react-i18next": "^15.5.1",
    "react-router-dom": "^6.30.0",
    "tailwindcss": "3.3.5",
    "vite": "^6.3.2",
    "xlsx": "^0.18.5",
    "ts-node": "^10.9.1",
    "typescript": "^4.9.5"
  },
  "devDependencies": {
    "@types/connect-history-api-fallback": "^1.5.4",
    "@types/file-saver": "^2.0.7",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@typescript-eslint/eslint-plugin": "^7.2.0",
    "@typescript-eslint/parser": "^7.2.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^8.57.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "postcss": "^8.5.3",
    "postcss-import": "^16.1.0",
    "postcss-nested": "^7.0.2",
    "postcss-nesting": "^13.0.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.19.4",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  }
}
