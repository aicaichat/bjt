# Qwen Code 配置
# 请复制此文件为 .env.local 并填入您的 API Key

# Qwen3-Coder API 配置
REACT_APP_OPENAI_API_KEY=your_api_key_here
REACT_APP_OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
REACT_APP_OPENAI_MODEL=qwen3-coder-plus

# Claude Code 配置 (可选)
REACT_APP_ANTHROPIC_BASE_URL=https://dashscope.aliyuncs.com/api/v2/apps/claude-code-proxy
REACT_APP_ANTHROPIC_AUTH_TOKEN=your-dashscope-apikey

# 其他配置
REACT_APP_QWEN_CODE_TEMPERATURE=0.7
REACT_APP_QWEN_CODE_MAX_TOKENS=4000 