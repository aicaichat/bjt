  }
  100% {
    background-position: 200% 0;
  }
}

.error-state {
  background: var(--consumable-error-color);
  color: white;
  padding: var(--consumable-space-4);
  border-radius: var(--consumable-rounded-md);
  text-align: center;
  font-weight: 500;
}

.success-state {
  background: var(--consumable-success-color);
  color: white;
  padding: var(--consumable-space-4);
  border-radius: var(--consumable-rounded-md);
  text-align: center;
  font-weight: 500;
}

/* ========= 可访问性增强 ========= */
.premium-consumable-card:focus {
  outline: 2px solid var(--consumable-primary-500);
  outline-offset: 2px;
}

.tooltip-field:focus-within {
  outline: 1px solid var(--consumable-primary-400);
  outline-offset: 1px;
}

/* 高对比度模式支持 */
@media (prefers-contrast: high) {
  .premium-consumable-card {
    border: 2px solid var(--consumable-secondary-400);
  }
  
  .card-field, .tooltip-field {
    border: 1px solid var(--consumable-secondary-400);
  }
}

/* 减少动画的用户偏好 */
@media (prefers-reduced-motion: reduce) {
  .premium-consumable-card,
  .card-image,
  .tooltip-field,
  .cart-item {
    transition: none;
  }
  
  .premium-consumable-card:hover {
    transform: none;
  }
  
  .loading-shimmer {
    animation: none;
  }
}

