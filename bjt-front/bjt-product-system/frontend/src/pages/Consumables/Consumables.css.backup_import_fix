/* Import Inter font for better typography */
@import url('https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap');

/* ========= 响应式断点 ========= */
/* Mobile: 320px - 767px */
/* Tablet: 768px - 1023px */
/* Desktop: 1024px+ */

/* ========= 基础容器样式 ========= */
.consumables-page {
  font-family: var(--consumable-font-family-sans);
  background: linear-gradient(135deg, var(--consumable-primary-50) 0%, var(--consumable-secondary-50) 100%);
  min-height: 100vh;
  padding: var(--consumable-space-4);
}

/* ========= 产品卡片网格 ========= */
.consumables-grid {
  display: grid;
  gap: var(--consumable-space-6);
  max-width: 1400px;
  margin: 0 auto;
  padding: var(--consumable-space-4);
}

/* 响应式网格布局 */
@media (min-width: 320px) {
  .consumables-grid {
    grid-template-columns: 1fr;
  }
}

@media (min-width: 768px) {
  .consumables-grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

@media (min-width: 1024px) {
  .consumables-grid {
    grid-template-columns: repeat(3, 1fr);
  }
}

@media (min-width: 1400px) {
  .consumables-grid {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* ========= 世界级产品卡片设计 ========= */
.premium-consumable-card {
  background: white;
  border-radius: var(--consumable-rounded-xl);
  box-shadow: var(--consumable-shadow-md);
  overflow: hidden;
  transition: var(--consumable-transition-normal);
  position: relative;
  cursor: pointer;
  transform: translateY(0);
  will-change: transform, box-shadow;
}

.premium-consumable-card:hover {
  transform: translateY(-8px);
  box-shadow: var(--consumable-shadow-xl);
  border: 1px solid var(--consumable-primary-200);
}

.premium-consumable-card:active {
  transform: translateY(-4px);
}

/* 产品图片容器 */
.card-image-container {
  position: relative;
  height: 240px;
  background: linear-gradient(135deg, var(--consumable-secondary-50), var(--consumable-primary-50));
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.card-image {
  max-width: 85%;
  max-height: 85%;
  object-fit: contain;
  transition: var(--consumable-transition-normal);
  filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.08));
}

.premium-consumable-card:hover .card-image {
  transform: scale(1.05);
}

/* 产品信息内容 */
.card-content {
  padding: var(--consumable-space-6);
}

.card-title {
  font-size: var(--consumable-text-lg);
  font-weight: 600;
  color: var(--consumable-secondary-900);
  margin: 0 0 var(--consumable-space-3) 0;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.card-subtitle {
  font-size: var(--consumable-text-sm);
  color: var(--consumable-secondary-600);
  margin: 0 0 var(--consumable-space-4) 0;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* 字段展示网格 */
.card-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--consumable-space-3);
  margin-top: var(--consumable-space-4);
}

.card-field {
  padding: var(--consumable-space-3);
  background: var(--consumable-secondary-50);
  border-radius: var(--consumable-rounded-md);
  border-left: 3px solid var(--consumable-primary-400);
}

.card-field-label {
  font-size: var(--consumable-text-xs);
  font-weight: 500;
  color: var(--consumable-secondary-600);
  text-transform: uppercase;
  letter-spacing: 0.025em;
  margin-bottom: var(--consumable-space-1);
}

.card-field-value {
  font-size: var(--consumable-text-sm);
  font-weight: 600;
  color: var(--consumable-secondary-900);
  word-break: break-word;
}

/* ========= Premium Tooltip设计 ========= */
.premium-tooltip {
  background: white;
  border-radius: var(--consumable-rounded-lg);
  box-shadow: var(--consumable-shadow-xl);
  border: 1px solid var(--consumable-secondary-200);
  padding: 0;
  max-width: 480px;
  overflow: hidden;
  z-index: var(--consumable-z-tooltip);
}

.tooltip-header {
  background: linear-gradient(135deg, var(--consumable-primary-600), var(--consumable-primary-700));
  color: white;
  padding: var(--consumable-space-4) var(--consumable-space-5);
  border-bottom: 1px solid var(--consumable-primary-500);
}

.tooltip-title {
  font-size: var(--consumable-text-lg);
  font-weight: 600;
  margin: 0;
  line-height: 1.3;
}

.tooltip-content {
  padding: var(--consumable-space-5);
  max-height: 400px;
  overflow-y: auto;
}

/* Tooltip字段分组 */
.tooltip-group {
  margin-bottom: var(--consumable-space-6);
}

.tooltip-group:last-child {
  margin-bottom: 0;
}

.tooltip-group-title {
  font-size: var(--consumable-text-sm);
  font-weight: 600;
  color: var(--consumable-primary-700);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: var(--consumable-space-3);
  padding-bottom: var(--consumable-space-2);
  border-bottom: 2px solid var(--consumable-primary-100);
  display: flex;
  align-items: center;
}

.tooltip-group-icon {
  width: 16px;
  height: 16px;
  margin-right: var(--consumable-space-2);
  opacity: 0.8;
}

.tooltip-fields {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: var(--consumable-space-4);
}

@media (max-width: 500px) {
  .tooltip-fields {
    grid-template-columns: 1fr;
  }
}

.tooltip-field {
  background: var(--consumable-secondary-50);
  padding: var(--consumable-space-3);
  border-radius: var(--consumable-rounded);
  border-left: 3px solid var(--consumable-primary-400);
  transition: var(--consumable-transition-fast);
}

.tooltip-field:hover {
  background: var(--consumable-primary-50);
  border-left-color: var(--consumable-primary-600);
}

.tooltip-field-label {
  font-size: var(--consumable-text-xs);
  font-weight: 500;
  color: var(--consumable-secondary-600);
  text-transform: uppercase;
  letter-spacing: 0.025em;
  margin-bottom: var(--consumable-space-1);
  line-height: 1.2;
}

.tooltip-field-value {
  font-size: var(--consumable-text-sm);
  font-weight: 600;
  color: var(--consumable-secondary-900);
  line-height: 1.3;
  word-break: break-word;
}

/* 单位显示样式 */
.unit-metric {
  color: var(--consumable-primary-600);
}

.unit-imperial {
  color: var(--consumable-info-color);
}

/* ========= 购物车样式 ========= */
.cart-item {
  background: white;
  border-radius: var(--consumable-rounded-lg);
  box-shadow: var(--consumable-shadow);
  padding: var(--consumable-space-4);
  margin-bottom: var(--consumable-space-3);
  border-left: 4px solid var(--consumable-primary-400);
  transition: var(--consumable-transition-fast);
}

.cart-item:hover {
  box-shadow: var(--consumable-shadow-md);
  border-left-color: var(--consumable-primary-600);
}

.cart-item-title {
  font-size: var(--consumable-text-base);
  font-weight: 600;
  color: var(--consumable-secondary-900);
  margin: 0 0 var(--consumable-space-2) 0;
}

.cart-item-fields {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
  gap: var(--consumable-space-2);
  margin-top: var(--consumable-space-3);
}

.cart-field {
  font-size: var(--consumable-text-xs);
  color: var(--consumable-secondary-600);
}

.cart-field-value {
  font-weight: 600;
  color: var(--consumable-secondary-900);
  margin-top: var(--consumable-space-1);
}

/* ========= 加载和状态样式 ========= */
.loading-shimmer {
  background: linear-gradient(90deg, var(--consumable-secondary-200) 25%, var(--consumable-secondary-100) 50%, var(--consumable-secondary-200) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% {
