}

.smart-filter-loading::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(255, 255, 255, 0.8);
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: inherit;
}

/* 响应式设计 */
@media (max-width: 768px) {
  .smart-filter-select {
    margin-bottom: 1rem;
  }
  
  .filter-breadcrumb {
    padding: 1rem;
  }
  
  .filter-breadcrumb .flex {
    flex-direction: column;
    gap: 0.5rem;
  }
  
  .material-btn {
    font-size: 0.75rem;
    padding: 0.5rem 0.75rem;
  }
}

/* 深色模式支持 */
@media (prefers-color-scheme: dark) {
  .smart-filter-select .ant-select {
