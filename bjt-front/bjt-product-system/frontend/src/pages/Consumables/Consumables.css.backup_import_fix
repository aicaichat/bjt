  }
  
  .material-btn:hover {
    background-color: #4b5563;
  }
}

/* 高对比度模式支持 */
@media (prefers-contrast: high) {
  .smart-filter-select .ant-select {
    border-width: 2px;
  }
  
  .material-btn {
    border-width: 2px;
  }
  
  .filter-count {
    border: 2px solid #000;
  }
}

/* 减少动画模式支持 */
@media (prefers-reduced-motion: reduce) {
  .pulse,
  .fade-in,
  .slide-up,
  .material-btn,
  .shape-selector label {
    animation: none !important;
    transition: none !important;
  }
  
  .smart-filter-select .ant-select:hover,
  .shape-selector label:hover {
    transform: none !important;
  }
}

/* 聚焦指示器 */
.smart-filter-select .ant-select-focused,
.material-btn:focus,
.shape-selector input:focus + label {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}

/* 选中状态指示器 */
.material-btn[aria-pressed="true"],
.shape-selector input:checked + label {
  position: relative;
}

.material-btn[aria-pressed="true"]::after,
.shape-selector input:checked + label::after {
  content: '✓';
  position: absolute;
  top: -4px;
  right: -4px;
  width: 20px;
  height: 20px;
  background: #10b981;
  color: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
