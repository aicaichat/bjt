/* Consumer页面世界级设计令牌和样式 */

/* ========= 设计令牌 (Design Tokens) ========= */
:root {
  /* Primary Colors - Professional Blue */
  --consumable-primary-50: #eff6ff;
  --consumable-primary-100: #dbeafe;
  --consumable-primary-200: #bfdbfe;
  --consumable-primary-300: #93c5fd;
  --consumable-primary-400: #60a5fa;
  --consumable-primary-500: #3b82f6;
  --consumable-primary-600: #2563eb;
  --consumable-primary-700: #1d4ed8;
  --consumable-primary-800: #1e40af;
  --consumable-primary-900: #1e3a8a;

  /* Secondary Colors - Warm Gray */
  --consumable-secondary-50: #fafaf9;
  --consumable-secondary-100: #f5f5f4;
  --consumable-secondary-200: #e7e5e4;
  --consumable-secondary-300: #d6d3d1;
  --consumable-secondary-400: #a8a29e;
  --consumable-secondary-500: #78716c;
  --consumable-secondary-600: #57534e;
  --consumable-secondary-700: #44403c;
  --consumable-secondary-800: #292524;
  --consumable-secondary-900: #1c1917;

  /* Status Colors */
  --consumable-success-color: #10b981;
  --consumable-warning-color: #f59e0b;
  --consumable-error-color: #ef4444;
  --consumable-info-color: #06b6d4;

  /* Typography */
  --consumable-font-family-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  --consumable-font-family-mono: 'SF Mono', Monaco, 'Cascadia Code', monospace;
  
  /* Font Sizes */
  --consumable-text-xs: 0.75rem;
  --consumable-text-sm: 0.875rem;
  --consumable-text-base: 1rem;
  --consumable-text-lg: 1.125rem;
  --consumable-text-xl: 1.25rem;
  --consumable-text-2xl: 1.5rem;
  --consumable-text-3xl: 1.875rem;

  /* Spacing */
  --consumable-space-1: 0.25rem;
  --consumable-space-2: 0.5rem;
  --consumable-space-3: 0.75rem;
  --consumable-space-4: 1rem;
  --consumable-space-5: 1.25rem;
  --consumable-space-6: 1.5rem;
  --consumable-space-8: 2rem;
  --consumable-space-10: 2.5rem;
  --consumable-space-12: 3rem;
  --consumable-space-16: 4rem;

  /* Border Radius */
  --consumable-rounded-sm: 0.125rem;
  --consumable-rounded: 0.25rem;
  --consumable-rounded-md: 0.375rem;
  --consumable-rounded-lg: 0.5rem;
  --consumable-rounded-xl: 0.75rem;
  --consumable-rounded-2xl: 1rem;

  /* Shadows */
  --consumable-shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --consumable-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
  --consumable-shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --consumable-shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  --consumable-shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);

  /* Transitions */
  --consumable-transition-fast: all 0.15s ease-in-out;
  --consumable-transition-normal: all 0.3s ease-in-out;
  --consumable-transition-slow: all 0.5s ease-in-out;

  /* Z-index layers */
  --consumable-z-tooltip: 1000;
  --consumable-z-modal: 1050;
  --consumable-z-popover: 1100;

  /* === 原有样式变量 === */
  --primary-color: #2563eb;
  --secondary-color: #f8fafc;
  --accent-color: #059669;
  --border-color: #e5e7eb;
  --hover-color: #eff6ff;
  --text-primary: #1f2937;
  --text-secondary: #6b7280;
  --text-tertiary: #9ca3af;
  
  /* Typography hierarchy */
  --font-size-xs: 0.75rem;
  --font-size-sm: 0.875rem;
  --font-size-base: 1rem;
  --font-size-lg: 1.125rem;
  --font-size-xl: 1.25rem;
  --font-size-2xl: 1.5rem;
  --font-size-3xl: 1.875rem;
  
  /* Spacing scale */
  --space-1: 0.25rem;
  --space-2: 0.5rem;
  --space-3: 0.75rem;
  --space-4: 1rem;
  --space-5: 1.25rem;
  --space-6: 1.5rem;
  --space-8: 2rem;
  --space-10: 2.5rem;
  --space-12: 3rem;
  --space-16: 4rem;
  
  /* Shadows */
  --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
  --shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.1), 0 1px 2px 0 rgba(0, 0, 0, 0.06);
  --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  
  /* Border radius */
  --radius-sm: 0.125rem;
  --radius: 0.25rem;
  --radius-md: 0.375rem;
  --radius-lg: 0.5rem;
  --radius-xl: 0.75rem;
}

