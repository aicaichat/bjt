/* 无障碍样式 */

/* 焦点状态 */
.consumables-page button:focus,
.consumables-page input:focus,
.consumables-page select:focus {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}

/* 键盘导航 */
.consumables-page [tabindex]:focus {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}

/* 高对比度模式 */
@media (forced-colors: active) {
  .consumables-page .consumable-card {
    border: 2px solid CanvasText;
  }

  .consumables-page .model-tag {
    border: 2px solid CanvasText;
  }

  .consumables-page .stock-tag {
    border: 2px solid CanvasText;
  }

  .consumables-page button,
  .consumables-page input,
  .consumables-page select {
    border: 2px solid currentColor;
  }
}

/* 屏幕阅读器专用类 */
.sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* 减少动画 */
@media (prefers-reduced-motion: reduce) {
  .consumables-page * {
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.01ms !important;
    scroll-behavior: auto !important;
  }
}

/* 颜色对比度 */
.consumables-page .text-gray-600 {
  color: #4b5563;
}

.consumables-page .text-gray-800 {
  color: #1f2937;
}

/* 可聚焦元素的视觉反馈 */
.consumables-page button:hover,
.consumables-page input:hover,
.consumables-page select:hover {
  border-color: #3b82f6;
}

/* 禁用状态 */
.consumables-page button:disabled,
.consumables-page input:disabled,
.consumables-page select:disabled {
  opacity: 0.6;
  cursor: not-allowed;
}

/* 错误状态 */
.consumables-page .error-state {
  border: 2px solid #dc2626;
}

.consumables-page .error-message {
  color: #dc2626;
  font-weight: 500;
}

/* 成功状态 */
.consumables-page .success-state {
  border: 2px solid #059669;
}

.consumables-page .success-message {
  color: #059669;
  font-weight: 500;
}

/* 加载状态 */
.consumables-page .loading-state {
  position: relative;
}

.consumables-page .loading-state::after {
  content: "加载中...";
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background-color: rgba(0, 0, 0, 0.7);
  color: white;
  padding: 0.5rem 1rem;
  border-radius: 0.25rem;
  font-size: 0.875rem;
}

/* 表单可访问性 */
.consumables-page .form-group {
  margin-bottom: 1rem;
}

.consumables-page .form-label {
  display: block;
  margin-bottom: 0.5rem;
  font-weight: 500;
}

.consumables-page .form-error {
  color: #dc2626;
  font-size: 0.875rem;
  margin-top: 0.25rem;
}

/* 按钮可访问性 */
.consumables-page .button {
  position: relative;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 0.5rem 1rem;
  font-weight: 500;
  border-radius: 0.375rem;
  transition: all 0.2s ease;
}

.consumables-page .button:focus-visible {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}

.consumables-page .button:disabled {
  opacity: 0.5;
  cursor: not-allowed;
}

/* 图片可访问性 */
.consumables-page img {
  max-width: 100%;
  height: auto;
}

.consumables-page img[alt] {
  font-size: 0.875rem;
  color: #6b7280;
}

/* 链接可访问性 */
.consumables-page a {
  color: #3b82f6;
  text-decoration: underline;
  text-underline-offset: 2px;
}

.consumables-page a:hover {
  color: #2563eb;
}

.consumables-page a:focus {
  outline: 2px solid #3b82f6;
  outline-offset: 2px;
}

/* 列表可访问性 */
.consumables-page ul,
.consumables-page ol {
  padding-left: 1.5rem;
  margin-bottom: 1rem;
}

.consumables-page li {
  margin-bottom: 0.5rem;
}

/* 表格可访问性 */
.consumables-page table {
  width: 100%;
  border-collapse: collapse;
  margin-bottom: 1rem;
}

.consumables-page th {
  text-align: left;
  padding: 0.75rem;
  background-color: #f3f4f6;
  font-weight: 600;
}

.consumables-page td {
  padding: 0.75rem;
  border-top: 1px solid #e5e7eb;
}

/* 暗色模式可访问性 */
@media (prefers-color-scheme: dark) {
  .consumables-page .button:focus-visible {
    outline-color: #60a5fa;
  }

  .consumables-page a {
    color: #60a5fa;
  }

  .consumables-page a:hover {
    color: #93c5fd;
  }

  .consumables-page th {
    background-color: #374151;
  }

  .consumables-page td {
    border-top-color: #4b5563;
  }
}

/* 键盘导航指示器 */
.consumables-page .keyboard-focus {
  box-shadow: 0 0 0 2px #3b82f6;
}

/* 必填字段标记 */
.consumables-page .required::after {
  content: "*";
  color: #dc2626;
  margin-left: 0.25rem;
}

/* 错误提示 */
.consumables-page .error-tooltip {
  color: #dc2626;
  font-size: 0.875rem;
  margin-top: 0.25rem;
}

/* 辅助文本 */
.consumables-page .helper-text {
  color: #6b7280;
  font-size: 0.875rem;
  margin-top: 0.25rem;
}

/* 加载状态动画 */
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

.consumables-page .loading-spinner {
  animation: spin 1s linear infinite;
}

/* 跳过导航链接 */
.consumables-page .skip-link {
  position: absolute;
  top: -40px;
  left: 0;
  background: #3b82f6;
  color: white;
  padding: 8px;
  z-index: 100;
}

.consumables-page .skip-link:focus {
  top: 0;
}

/* 错误消息容器 */
.consumables-page .error-container {
  border: 1px solid #dc2626;
  background-color: #fee2e2;
  padding: 1rem;
  margin: 1rem 0;
  border-radius: 0.375rem;
}

/* 成功消息容器 */
.consumables-page .success-container {
  border: 1px solid #059669;
  background-color: #d1fae5;
  padding: 1rem;
  margin: 1rem 0;
  border-radius: 0.375rem;
}

/* 警告消息容器 */
.consumables-page .warning-container {
  border: 1px solid #d97706;
  background-color: #fef3c7;
  padding: 1rem;
  margin: 1rem 0;
  border-radius: 0.375rem;
}

/* 信息消息容器 */
.consumables-page .info-container {
  border: 1px solid #3b82f6;
  background-color: #dbeafe;
  padding: 1rem;
  margin: 1rem 0;
  border-radius: 0.375rem;
} 